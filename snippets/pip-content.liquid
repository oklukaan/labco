{%- comment -%}
  Ürün Bilgi Paneli — içerik gövdesi (sekme paneli ve akordeon gövdesi ortak kullanır).
  Kullanım: {% render 'pip-content', block: block, product: product %}

  Veri kaynağı: product.metafields.pip.panel.value (metaobject tipi pip_panel).
  İçerik tipine göre okunacak panel alanları sabittir:
    quote      → quote (metaobject pip_quote)
    comparison → comparison (list pip_comparison_row)
    features_info     → features_info (giriş: intro_info)
    features_benefits → features_benefits (pip_benefit: title + icon; açıklama yok, tek satır)
    dosage     → dosage (satır formatı); alt metin yalnızca blok ayarı override_footer
    facts      → facts (satır formatı), porsiyon notu: facts_note, alt metin: facts_footer
    richtext   → blok ayarı richtext
  Bloktaki "Ortak içerik" ayarları (override_features, override_rows, override_footer) doluysa panel yerine kullanılır.
  Bloğun intro ayarı doluysa panel girişinin üstüne eklenir.

  Ana veri boşsa HİÇBİR çıktı üretilmez. Varsayım: giriş/alt metin tek başına bir sekmeyi
  veya akordeonu görünür tutmaz.
  Panel metin alanları rich_text_field veya multi_line_text_field olabilir; ikisi de desteklenir.
{%- endcomment -%}

{%- liquid
  assign pip_type = block.settings.content_type | default: 'richtext'
  # Geriye dönük yedek: dönüştürülmemiş eski şablonlarda content_type hâlâ 'icon_list' gelebilir.
  # Yeni şemada bu seçenek yok; eski list_source değerine göre iki liste tipinden birine eşlenir.
  if pip_type == 'icon_list'
    if block.settings.list_source == 'features_benefits'
      assign pip_type = 'features_benefits'
    else
      assign pip_type = 'features_info'
    endif
  endif
  assign pip_panel = product.metafields.pip.panel.value
  if pip_panel.system.type != 'pip_panel'
    assign pip_panel = nil
  endif

  assign pip_list = nil
  assign pip_quote = nil
  assign pip_rows_text = ''
  assign pip_panel_intro = nil
  assign pip_footer_field = nil
  assign pip_note_field = nil
  assign pip_is_list = false
  if pip_type == 'features_info' or pip_type == 'features_benefits'
    assign pip_is_list = true
  endif

  case pip_type
    when 'comparison'
      assign pip_list = pip_panel.comparison.value
    when 'features_info'
      assign pip_list = block.settings.override_features | default: pip_panel.features_info.value
      assign pip_panel_intro = pip_panel.intro_info
    when 'features_benefits'
      assign pip_list = block.settings.override_features | default: pip_panel.features_benefits.value
    when 'quote'
      assign pip_quote = pip_panel.quote.value
    when 'dosage'
      assign pip_rows_text = block.settings.override_rows | default: pip_panel.dosage.value
    when 'facts'
      assign pip_rows_text = block.settings.override_rows | default: pip_panel.facts.value
      assign pip_note_field = pip_panel.facts_note
      assign pip_footer_field = pip_panel.facts_footer
  endcase

  # Giriş: bloğun intro ayarı (kalın başlık) + panel girişi (normal ağırlıkta açıklama paragrafı), bu sırayla.
  assign pip_intro = block.settings.intro
  assign pip_check = pip_intro | strip_html | strip
  if pip_check == blank
    assign pip_intro = ''
  endif
  assign pip_extra = ''
  if pip_panel_intro.type == 'rich_text_field'
    assign pip_extra = pip_panel_intro | metafield_tag
  elsif pip_panel_intro.type == 'multi_line_text_field' or pip_panel_intro.type == 'single_line_text_field'
    assign pip_extra = pip_panel_intro.value | escape | newline_to_br | prepend: '<p>' | append: '</p>'
  endif
  assign pip_check = pip_extra | strip_html | strip
  # Panelde açıklama yoksa (ör. fayda maddeleri) bloğun "Açıklama" ayarı kullanılır.
  if pip_check == blank and pip_is_list
    assign pip_extra = block.settings.lead
    assign pip_check = pip_extra | strip_html | strip
  endif
  assign pip_has_lead = false
  if pip_check != blank
    assign pip_has_lead = true
  endif
  assign pip_check = pip_intro | strip_html | strip
  assign pip_has_intro = false
  if pip_check != blank
    assign pip_has_intro = true
  endif

  # Alt metin: override_footer (dosage/facts) doluysa öncelikli; değilse panel alanı (yalnızca facts'te var).
  assign pip_footer = ''
  if pip_type == 'dosage' or pip_type == 'facts'
    assign pip_footer = block.settings.override_footer
    assign pip_check = pip_footer | strip_html | strip
    if pip_check == blank
      assign pip_footer = ''
      if pip_footer_field.type == 'rich_text_field'
        assign pip_footer = pip_footer_field | metafield_tag
      elsif pip_footer_field.type == 'multi_line_text_field' or pip_footer_field.type == 'single_line_text_field'
        assign pip_footer = pip_footer_field.value | escape | newline_to_br | prepend: '<p>' | append: '</p>'
      endif
    endif
  endif
  assign pip_check = pip_footer | strip_html | strip
  assign pip_has_footer = false
  if pip_check != blank
    assign pip_has_footer = true
  endif

  # Facts porsiyon notu.
  assign pip_note = ''
  if pip_note_field.type == 'rich_text_field'
    assign pip_note = pip_note_field | metafield_tag
  elsif pip_note_field.type == 'multi_line_text_field' or pip_note_field.type == 'single_line_text_field'
    assign pip_note = pip_note_field.value | escape | newline_to_br | prepend: '<p>' | append: '</p>'
  endif
  assign pip_note_check = pip_note | strip_html | strip

  # Satır verisi: newline_to_br ile normalize edip satırlara böl (\r\n güvenli).
  assign pip_lines = pip_rows_text | newline_to_br | split: '<br />'
-%}

{%- capture pip_main -%}
  {%- case pip_type -%}
    {%- when 'richtext' -%}
      {%- assign pip_check = block.settings.richtext | strip_html | strip -%}
      {%- if pip_check != blank -%}
        <div class="pip-rte">{{ block.settings.richtext }}</div>
      {%- endif -%}

    {%- when 'features_info', 'features_benefits' -%}
      {%- liquid
        # Madde ikonu: maddenin kendi icon alanı her zaman önceliklidir. Boşsa blok ayarı:
        #   check  → pip-icon 'check_filled' (varsayılan; ayar hiç kaydedilmemişse de bu)
        #   custom → list_icon_image (görsel seçilmemişse ikon gösterilmez)
        #   none   → varsayılan ikon yok
        # İkon kolonu, listede en az bir ikon varsa tüm maddelerde aynı genişlikte çizilir.
        assign pip_icon_style = block.settings.list_icon_style | default: 'check'
        assign pip_layout = block.settings.list_layout | default: 'auto'
        # Fayda maddeleri (features_benefits) düz liste: tek satır, normal ağırlık, "Başlık – açıklama".
        assign pip_plain = false
        if pip_type == 'features_benefits'
          assign pip_plain = true
        endif
        if pip_layout == 'auto'
          if pip_plain
            assign pip_layout = 'inline'
          else
            assign pip_layout = 'stacked'
          endif
        endif

        # Alt alta listede açıklamalı madde varsa büyük madde stili (24px ikon, 18px başlık).
        assign pip_list_lg = false
        if pip_layout == 'stacked'
          for pip_item in pip_list
            if pip_item.system.type == 'pip_feature' and pip_item.description.value != blank
              assign pip_list_lg = true
              break
            endif
          endfor
        endif
        assign pip_has_fallback = false
        if pip_icon_style == 'check'
          assign pip_has_fallback = true
        elsif pip_icon_style == 'custom' and block.settings.list_icon_image != blank
          assign pip_has_fallback = true
        endif
        assign pip_show_col = pip_has_fallback
        unless pip_show_col
          for pip_item in pip_list
            if pip_item.icon.value.preview_image != blank
              assign pip_show_col = true
              break
            endif
          endfor
        endunless
      -%}
      {%- capture pip_items -%}
        {%- for pip_item in pip_list -%}
          {%- comment -%} features_info / override: pip_feature; features_benefits: pip_benefit (title, icon). {%- endcomment -%}
          {%- if pip_item.system.type != 'pip_feature' and pip_item.system.type != 'pip_benefit' -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign pip_title = pip_item.title.value | strip
            assign pip_desc = ''
            if pip_item.description.type == 'rich_text_field'
              assign pip_desc = pip_item.description | metafield_tag | strip
            endif
            assign pip_check = pip_desc | strip_html | strip
            if pip_check == blank
              assign pip_desc = ''
            endif
            if pip_title == blank and pip_desc == blank
              continue
            endif

            # Görünüm: inline → başlık – açıklama aynı satırda; stacked → alt alta.
            # Açıklaması boş madde her görünümde yalnızca başlık satırıdır.
            assign pip_inline = false
            if pip_title != blank and pip_desc != blank and pip_layout == 'inline'
              assign pip_inline = true
            endif

            assign pip_img = pip_item.icon.value
          -%}
          <li class="pip-feature{% if pip_inline %} pip-feature--inline{% endif %}">
            {%- if pip_show_col -%}
              <span class="pip-feature__media">
                {%- if pip_img.preview_image != blank -%}
                  {{
                    pip_img.preview_image
                    | image_url: width: 40
                    | image_tag:
                      width: 20,
                      height: 20,
                      widths: '20, 40',
                      sizes: '20px',
                      loading: 'lazy',
                      alt: '',
                      class: 'pip-feature__icon'
                  }}
                {%- elsif pip_icon_style == 'check' -%}
                  {% render 'pip-icon', icon: 'check_filled', class: 'pip-feature__icon' %}
                {%- elsif pip_icon_style == 'custom' and block.settings.list_icon_image != blank -%}
                  {{
                    block.settings.list_icon_image
                    | image_url: width: 40
                    | image_tag:
                      width: 20,
                      height: 20,
                      widths: '20, 40',
                      sizes: '20px',
                      loading: 'lazy',
                      alt: '',
                      class: 'pip-feature__icon'
                  }}
                {%- endif -%}
              </span>
            {%- endif -%}
            <div class="pip-feature__text">
              {%- if pip_title != blank -%}
                <span class="pip-feature__title">{{ pip_title | escape }}</span>
              {%- endif -%}
              {%- if pip_inline -%}
                <span class="pip-feature__sep"> – </span>
              {%- endif -%}
              {%- if pip_desc != blank -%}
                <div class="pip-feature__desc pip-rte">{{ pip_desc }}</div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign pip_check = pip_items | strip -%}
      {%- if pip_check != blank -%}
        <ul class="pip-features{% if pip_list_lg %} pip-features--lg{% endif %}{% if pip_plain %} pip-features--plain{% endif %}" role="list">{{ pip_items }}</ul>
      {%- endif -%}

    {%- when 'comparison' -%}
      {%- capture pip_rows -%}
        {%- for pip_row in pip_list -%}
          {%- if pip_row.system.type != 'pip_comparison_row' -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign pip_title = pip_row.title.value | strip
            if pip_title == blank
              continue
            endif
            assign pip_desc = pip_row.description.value | strip
            assign pip_link = pip_row.link_url.value | strip
            # Varsayım: link etiketi boşsa İngilizce varsayılan kullanılır.
            assign pip_link_label = pip_row.link_label.value | strip | default: 'Learn more'
            assign pip_img = pip_row.icon.value
          -%}
          <tr>
            <td class="pip-cmp__feature-cell">
              <div class="pip-cmp__feature">
                {%- if pip_img.preview_image != blank -%}
                  {{
                    pip_img.preview_image
                    | image_url: width: 64
                    | image_tag:
                      width: 32,
                      height: 32,
                      widths: '32, 64',
                      sizes: '32px',
                      loading: 'lazy',
                      alt: '',
                      class: 'pip-cmp__icon'
                  }}
                {%- endif -%}
                <div class="pip-cmp__text">
                  <span class="pip-cmp__title">{{ pip_title | escape }}</span>
                  {%- if pip_desc != blank -%}
                    <span class="pip-cmp__desc">{{ pip_desc | escape | newline_to_br }}</span>
                  {%- endif -%}
                  {%- if pip_link != blank -%}
                    <a class="pip-cmp__link" href="{{ pip_link | escape }}">{{ pip_link_label | escape }}</a>
                  {%- endif -%}
                </div>
              </div>
            </td>
            <td class="pip-cmp__mark pip-cmp__brand">
              {%- if pip_row.ours.value == true -%}
                {% render 'pip-icon', icon: 'check' %}<span class="pip-sr">Yes</span>
              {%- else -%}
                {% render 'pip-icon', icon: 'cross' %}<span class="pip-sr">No</span>
              {%- endif -%}
            </td>
            <td class="pip-cmp__mark">
              {%- if pip_row.others.value == true -%}
                {% render 'pip-icon', icon: 'check' %}<span class="pip-sr">Yes</span>
              {%- else -%}
                {% render 'pip-icon', icon: 'cross' %}<span class="pip-sr">No</span>
              {%- endif -%}
            </td>
          </tr>
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign pip_check = pip_rows | strip -%}
      {%- if pip_check != blank -%}
        {%- liquid
          # Marka sütunu başlığı yedek sırası:
          #   1. blok ayarı brand_image  2. temanın logosu (settings.logo)
          #   3. metin: blok brand_label → mağaza adı
          assign pip_brand_label = block.settings.brand_label | strip | default: shop.name
          assign pip_others_label = block.settings.others_label | strip | default: 'Others'
          assign pip_brand_image = block.settings.brand_image | default: settings.logo
          assign pip_logo_alt = pip_brand_image.alt | default: pip_brand_label
        -%}
        <table class="pip-table pip-cmp">
          <colgroup>
            <col>
            <col class="pip-cmp__col-mark">
            <col class="pip-cmp__col-mark">
          </colgroup>
          <thead>
            <tr>
              <th scope="col" class="pip-cmp__head-feature"><span class="pip-sr">Feature</span></th>
              <th scope="col" class="pip-cmp__brand pip-cmp__head-brand">
                <span class="pip-cmp__brand-box">
                  {%- if pip_brand_image != blank -%}
                    {{
                      pip_brand_image
                      | image_url: width: 120
                      | image_tag:
                        widths: '60, 120',
                        sizes: '44px',
                        loading: 'lazy',
                        alt: pip_logo_alt,
                        class: 'pip-cmp__logo'
                    }}
                  {%- else -%}
                    <span class="pip-cmp__brand-label">{{ pip_brand_label | escape }}</span>
                  {%- endif -%}
                </span>
              </th>
              <th scope="col" class="pip-cmp__head-others">{{ pip_others_label | escape }}</th>
            </tr>
          </thead>
          <tbody>{{ pip_rows }}</tbody>
        </table>
      {%- endif -%}

    {%- when 'quote' -%}
      {%- if pip_quote.system.type == 'pip_quote' -%}
        {%- liquid
          assign pip_text = pip_quote.quote.value | strip
          assign pip_name = pip_quote.author_name.value | strip
          assign pip_role = pip_quote.author_title.value | strip
          assign pip_img = pip_quote.photo.value
          if pip_img.preview_image == blank and block.settings.quote_photo != blank
            assign pip_img = block.settings.quote_photo
          endif
        -%}
        {%- if pip_text != blank -%}
          <figure class="pip-quote">
            <blockquote class="pip-quote__text">
              <p>&quot;{{ pip_text | escape | newline_to_br }}&quot;</p>
            </blockquote>
            {%- if pip_name != blank or pip_role != blank or pip_img.preview_image != blank -%}
              <figcaption class="pip-quote__author">
                {%- if pip_img.preview_image != blank -%}
                  {{
                    pip_img.preview_image
                    | image_url: width: 112
                    | image_tag:
                      width: 56,
                      height: 56,
                      widths: '56, 112',
                      sizes: '56px',
                      loading: 'lazy',
                      alt: '',
                      class: 'pip-quote__photo'
                  }}
                {%- endif -%}
                <span class="pip-quote__meta">
                  {%- if pip_name != blank -%}
                    <span class="pip-quote__name">{{ pip_name | escape }}</span>
                  {%- endif -%}
                  {%- if pip_role != blank -%}
                    <span class="pip-quote__role">{{ pip_role | escape }}</span>
                  {%- endif -%}
                </span>
              </figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
      {%- endif -%}

    {%- when 'dosage' -%}
      {%- capture pip_rows -%}
        {%- for pip_line in pip_lines -%}
          {%- assign pip_line_check = pip_line | strip -%}
          {%- if pip_line_check == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign pip_cells = pip_line | split: '|'
            assign pip_size = pip_cells[0] | strip
            assign pip_sub = pip_cells[1] | strip
            assign pip_dose = pip_cells[2] | strip
          -%}
          <tr>
            <td class="pip-dosage__size-cell">
              {%- if pip_size != blank -%}<strong class="pip-dosage__size">{{ pip_size | escape }}</strong>{%- endif -%}
              {%- if pip_sub != blank -%}<span class="pip-dosage__sub">{{ pip_sub | escape }}</span>{%- endif -%}
            </td>
            <td class="pip-dosage__dose-cell">
              {%- if pip_dose != blank -%}
                {%- liquid
                  # Doz metnindeki ilk sayı kadar daire çizilir ("2 soft chews" → ●●). "1/2" ve "½" yarım dairedir.
                  # Sayı yoksa daire çizilmez. Sekmelerde daireler CSS ile gizlenir (referans tasarımla aynı).
                  assign pip_half = false
                  assign pip_head = pip_dose | slice: 0, 3
                  assign pip_head1 = pip_dose | slice: 0, 1
                  if pip_head == '1/2' or pip_head1 == '½'
                    assign pip_half = true
                    assign pip_qty = 0
                  else
                    assign pip_qty = pip_dose | split: ' ' | first | plus: 0 | floor
                  endif
                -%}
                {%- if pip_half or pip_qty > 0 -%}
                  <span class="pip-dosage__dots" aria-hidden="true">
                    {%- if pip_half -%}
                      <span class="pip-dosage__dot pip-dosage__dot--half"></span>
                    {%- else -%}
                      {%- for pip_i in (1..pip_qty) limit: 10 -%}
                        <span class="pip-dosage__dot"></span>
                      {%- endfor -%}
                    {%- endif -%}
                  </span>
                {%- endif -%}
                <strong class="pip-dosage__dose">{{ pip_dose | escape }}</strong>
              {%- endif -%}
            </td>
          </tr>
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign pip_check = pip_rows | strip -%}
      {%- if pip_check != blank -%}
        {%- liquid
          assign pip_col1 = block.settings.dosage_col1_label | strip
          assign pip_col2 = block.settings.dosage_col2_label | strip
        -%}
        <table class="pip-table pip-dosage">
          {%- if pip_col1 != blank or pip_col2 != blank -%}
            <thead>
              <tr>
                <th scope="col">{{ pip_col1 | escape }}</th>
                <th scope="col" class="pip-dosage__dose-cell">{{ pip_col2 | escape }}</th>
              </tr>
            </thead>
          {%- endif -%}
          <tbody>{{ pip_rows }}</tbody>
        </table>
      {%- endif -%}

    {%- when 'facts' -%}
      {%- capture pip_rows -%}
        {%- for pip_line in pip_lines -%}
          {%- assign pip_line_check = pip_line | strip -%}
          {%- if pip_line_check == blank -%}{%- continue -%}{%- endif -%}
          {%- assign pip_cells = pip_line | split: '|' -%}
          {%- assign pip_name = pip_cells[0] | strip -%}
          <tr>
            <th scope="row" class="pip-facts__name">{{ pip_name | escape }}</th>
            <td class="pip-facts__values">
              {%- for pip_cell in pip_cells offset: 1 -%}
                {%- assign pip_value = pip_cell | strip -%}
                {%- if pip_value != blank -%}
                  <span class="pip-facts__value">{{ pip_value | escape }}</span>
                {%- endif -%}
              {%- endfor -%}
            </td>
          </tr>
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign pip_check = pip_rows | strip -%}
      {%- if pip_check != blank -%}
        {%- assign pip_facts_title = block.settings.facts_title | strip -%}
        <div class="pip-facts">
          {%- if pip_facts_title != blank -%}
            <p class="pip-facts__title">{{ pip_facts_title | escape }}</p>
          {%- endif -%}
          {%- if pip_note_check != blank -%}
            <div class="pip-facts__note pip-rte">{{ pip_note }}</div>
          {%- endif -%}
          <table class="pip-table pip-facts__table">
            <tbody>{{ pip_rows }}</tbody>
          </table>
        </div>
      {%- endif -%}
  {%- endcase -%}
{%- endcapture -%}

{%- assign pip_check = pip_main | strip -%}
{%- if pip_check != blank -%}
  <div class="pip-content pip-content--{{ pip_type }}">
    {%- if pip_has_intro -%}
      <div class="pip-content__intro pip-rte">{{ pip_intro }}</div>
    {%- endif -%}
    {%- if pip_has_lead -%}
      <div class="pip-content__lead pip-rte">{{ pip_extra }}</div>
    {%- endif -%}
    {{ pip_main }}
    {%- if pip_has_footer -%}
      <div class="pip-content__footer pip-rte">{{ pip_footer }}</div>
    {%- endif -%}
  </div>
{%- endif -%}
