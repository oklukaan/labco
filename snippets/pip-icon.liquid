{%- comment -%}
  Ürün Bilgi Paneli — ikonlar.
  Kullanım: {% render 'pip-icon', icon: 'check' %}  (check | cross | chevron | check_filled | check_circle)
  Opsiyonel: class (ek sınıf)
{%- endcomment -%}
{%- case icon -%}
  {%- when 'check' -%}
    <svg class="pip-icon pip-icon--check {{ class }}" viewBox="0 0 25 25" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M9.3 16.405 5.8 12.905a.99.99 0 0 0-1.4 0 .99.99 0 0 0 0 1.4l4.19 4.19a.99.99 0 0 0 1.41 0L20.6 7.905a.99.99 0 0 0 0-1.4.99.99 0 0 0-1.4 0l-9.9 9.9Z"/></svg>
  {%- when 'cross' -%}
    <svg class="pip-icon pip-icon--cross {{ class }}" viewBox="0 0 16 16" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.2 3.807a.664.664 0 0 0-.94 0L8 7.06 4.74 3.8a.664.664 0 1 0-.94.94L7.06 8 3.8 11.26a.664.664 0 1 0 .94.94L8 8.94l3.26 3.26a.664.664 0 1 0 .94-.94L8.94 8l3.26-3.26a.668.668 0 0 0 0-.933Z"/></svg>
  {%- when 'chevron' -%}
    <svg class="pip-icon pip-icon--chevron {{ class }}" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16.59 8.295 12 12.875l-4.59-4.58L6 9.705l6 6 6-6-1.41-1.41Z"/></svg>
  {%- when 'check_filled' -%}
    {%- comment -%} Dolu daire currentColor (tema metin rengini izler), tik beyaz. {%- endcomment -%}
    <svg class="pip-icon pip-icon--check-filled {{ class }}" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="10" fill="currentColor"/><path d="M5.75 10.25l2.75 2.75 5.75-6" fill="none" stroke="#fff" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'check_circle' -%}
    <svg class="pip-icon pip-icon--check-circle {{ class }}" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10.6 16.6l7.05-7.05-1.4-1.4-5.65 5.65-2.85-2.85-1.4 1.4 4.25 4.25ZM12 22a9.74 9.74 0 0 1-3.9-.788 10.1 10.1 0 0 1-3.175-2.137A10.1 10.1 0 0 1 2.788 15.9 9.74 9.74 0 0 1 2 12c0-1.383.263-2.683.788-3.9a10.1 10.1 0 0 1 2.137-3.175A10.1 10.1 0 0 1 8.1 2.788 9.74 9.74 0 0 1 12 2c1.383 0 2.683.263 3.9.788a10.1 10.1 0 0 1 3.175 2.137A10.1 10.1 0 0 1 21.212 8.1 9.74 9.74 0 0 1 22 12a9.74 9.74 0 0 1-.788 3.9 10.1 10.1 0 0 1-2.137 3.175 10.1 10.1 0 0 1-3.175 2.137A9.74 9.74 0 0 1 12 22Z"/></svg>
{%- endcase -%}
